{
  "name": "ip-finder",
  "version": "1.0.0",
  "author": "FCG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.fcg.ipfinder",
    "productName": "IP Finder",
    "directories": {
      "output": "../build/electron"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/IPFinder.exe",
        "to": "backend/IPFinder.exe"
      },
      {
        "from": "../keywords.txt",
        "to": "backend/keywords.txt"
      }
    ],
    "win": {
      "target": "dir"
    }
  }
}